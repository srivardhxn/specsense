# Copy this file to .env and fill in your real keys.
# Both are 100% free, no credit card required.

# Get a free key at https://serpapi.com (250 free searches/month, no card)
SERPAPI_KEY=your_serpapi_key_here

# Get a free key at https://aistudio.google.com
# (sign in with any Google account -> "Get API key" -> create key)
# Free tier: no card, generous daily limit.
GEMINI_API_KEY=your_gemini_key_here

# Backup LLM provider (free, no card) -- used automatically if Gemini's
# quota runs out. Get a free key at https://console.groq.com
GROQ_API_KEY=your_groq_key_here

# Optional: folder to load provided datasets/reference artifacts from
# for the RAG layer. Defaults to ./datasets if not set.
DATASET_DIR=./datasets
